# الفايل ده فيه "الأسرار" (Environment Variables) بتاعة السيرفر.
# لازم تعمل منه نسخة وتسميها .env وتملى البيانات دي:
# - MONGODB_URI: رابط قاعدة البيانات.
# - JWT_SECRET: كلمة سر قوية عشان تشفير التوكنات.
# - إعدادات الـ SMTP: لو عايز السيرفر يبعت إيميلات حقيقية.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/social-media-platform
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@socialsphere.local

# Google Auth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
